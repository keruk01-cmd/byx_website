{
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" },
    { "source": "/guidelines", "destination": "/index.html" },
    { "source": "/guidelines/:path*", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/guidelines/:path*", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
      { "key": "Cache-Control", "value": "private, no-store" }
    ] }
  ]
}
